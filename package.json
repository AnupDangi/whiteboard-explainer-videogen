{
  "name": "explain-canvas-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hypothesis-driven whiteboard explainer engine: scene data, deterministic playback, progressive delivery and MP4 export",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && node --env-file-if-exists=.env dist/src/server.js",
    "test": "npm run build && APP_LOG_PATH=.data/test-app.log node --test test/*.test.js",
    "benchmark": "npm run build && node dist/scripts/benchmark.js",
    "export": "npm run build && node dist/scripts/export.js",
    "test:live": "npm run build && node --env-file-if-exists=.env dist/scripts/live-evaluation.js",
    "generate-video": "npm run build && node --env-file-if-exists=.env dist/scripts/generate-video.js",
    "router:report": "npm run build && node dist/scripts/router-report.js",
    "baseline:v1": "npm run build && node dist/scripts/capture-v1-baseline.js",
    "bench:semantic:plant": "npm run build && node dist/scripts/bench-semantic-plant.js",
    "test:semantic": "npm run build && node --test test/semantic*.test.js",
    "test:live:v2": "npm run build && node --env-file-if-exists=.env dist/scripts/live-v2-evaluation.js",
    "test:live:v2:smoke": "npm run build && node --env-file-if-exists=.env dist/scripts/live-v2-evaluation.js --smoke",
    "bench:semantic:archetypes": "npm run build && node dist/scripts/bench-semantic-archetypes.js",
    "bench:visual": "npm run build && node dist/scripts/run-visual-bench.js",
    "calibrate:semantic:critic": "npm run build && node --env-file-if-exists=.env dist/scripts/calibrate-semantic-critic.js",
    "export:example": "npm run build && node --env-file-if-exists=.env dist/scripts/export-example-video.js",
    "matrix:live": "npm run build && node --env-file-if-exists=.env dist/scripts/live-matrix.js",
    "bench:representation": "npm run build && node dist/scripts/bench-representation.js"
  },
  "optionalDependencies": {
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "ipaddr.js": "^2.5.0"
  }
}
