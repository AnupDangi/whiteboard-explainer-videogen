{
  "name": "explain-canvas-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hypothesis-driven whiteboard explainer engine: scene data, deterministic playback, progressive delivery and MP4 export",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "voice-engine:setup": "pnpm --dir voice-engine run setup",
    "typecheck:hypothesis": "tsc --noEmit -p tsconfig.json",
    "test:hypothesis": "pnpm run build && node scripts/shared-manifest.mjs --check && node --test dist/src/__tests__/*.test.js && node --test scripts/audit-retained-board-v2.test.mjs && python3 -m unittest discover -s src/shared/alignment -p 'test_*.py' && python3 -m unittest discover -s rag-engine -p 'test_*.py'",
    "fixture:hypothesis": "pnpm run test:hypothesis",
    "run:hypothesis": "pnpm run build && node dist/src/run/cli.js",
    "preview:hypothesis": "pnpm run build && node dist/src/export/player/previewCli.js",
    "run:hypothesis:live": "pnpm run build && node dist/src/run/liveCli.js",
    "run:lesson": "pnpm run build && node dist/src/run/lessonCli.js",
    "video:render": "pnpm run build && node dist/src/run/lessonCli.js",
    "asset-bridge:freeze": "pnpm run build && node dist/src/assets/bridgeExportCli.js",
    "video:one-shot": "node scripts/one-shot-video.mjs",
    "catalog:build": "node scripts/build-catalog.mjs && node scripts/embed-catalog.mjs",
    "catalog:e4:calibrate": "pnpm run build && node dist/src/assets/e4CalibrationCli.js",
    "plan:calibrate": "pnpm run build && node dist/src/harness/planCalibrationCli.js",
    "scene:calibrate": "pnpm run build && node dist/src/harness/sceneCalibrationCli.js",
    "icons:ingest": "pnpm run build && node scripts/ingest-icon-library.mjs",
    "reliability:run": "pnpm run build && node dist/src/harness/reliabilityCli.js",
    "reference:lamina": "node scripts/lamina-reference.mjs ../lamina-labs-video harness/reference/lamina",
    "judge:hypothesis": "node dist/src/harness/judgeCli.js",
    "judge:human:hypothesis": "pnpm run build && node dist/src/harness/humanReviewCli.js",
    "judge:human:pack:hypothesis": "pnpm run build && node dist/src/harness/humanReviewPackCli.js",
    "judge:e5:human:hypothesis": "pnpm run build && node dist/src/harness/e5HumanReviewCli.js",
    "judge:e5:human:pack:hypothesis": "pnpm run build && node dist/src/harness/e5HumanReviewPackCli.js",
    "strip:scene": "node scripts/render-strip.mjs",
    "baseline:freeze": "node scripts/baselines.mjs --freeze",
    "baseline:verify": "node scripts/baselines.mjs",
    "metrics:boards": "pnpm run build && node dist/src/harness/boardMetricsCli.js",
    "validate:batch": "pnpm run build && node dist/src/harness/validationBatchCli.js",
    "release:gates": "pnpm run build && node dist/src/harness/releaseGateCli.js",
    "manifest:shared": "node scripts/shared-manifest.mjs",
    "assets:sync": "node scripts/assets-sync.mjs",
    "audit:run": "pnpm run build && node dist/src/harness/auditCli.js",
    "icons:iconify": "pnpm run build && node scripts/ingest-iconify-sets.mjs && node scripts/embed-catalog.mjs",
    "icons:search": "pnpm run build && ASSET_USAGE_CONTEXT=${ASSET_USAGE_CONTEXT:-local-dev} node dist/src/assets/iconSearchCli.js"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.538",
    "@types/node": "^26.5.0",
    "domhandler": "^5.0.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "cheerio": "^1.2.0",
    "ipaddr.js": "^2.5.0",
    "mathjax-full": "^3.2.1",
    "roughjs": "4.6.6",
    "svg-path-properties": "^2.1.0",
    "svgpath": "^2.6.0",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": ">=0.9.12"
    }
  }
}
