{
  "name": "voice-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal local CPU TTS router: Supertonic by default, Piper fallback",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "setup": "sh setup.sh",
    "synth": "node dist/cli.js",
    "compare:en": "pnpm run build && node dist/compare-en.js"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.28.2"
}
