# Copy to .env and fill in. Offline tests (pnpm run test:hypothesis) need none of this.
# Every variable below is read by code in this repository; nothing else is.

# --- Models (OpenRouter) -------------------------------------------------------
# Every pipeline stage model is configuration; there are no code defaults.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # any OpenAI-compatible endpoint
# OPENROUTER_CONTENT_MODEL=    # S1b-S4 default (legacy alias: OPENROUTER_DIRECTOR_MODEL)
# OPENROUTER_SYLLABUS_MODEL=   # optional per-stage overrides of the content model
# OPENROUTER_CONCEPTS_MODEL=
# OPENROUTER_PLAN_MODEL=
# OPENROUTER_SCRIPT_MODEL=
# OPENROUTER_SCENE_MODEL=      # S6 board planner (required)
# OPENROUTER_VISION_MODEL=qwen/qwen3-vl-32b-instruct   # vision judge (required for judge:hypothesis; validated 2026-09-30)
# HYPOTHESIS_ENV_FILE=         # read a different env file

# --- Document intake (src/experimental/hypothesis/v1_claude/plan/intake/) -----
# PDF reader. poppler (default) needs pdftotext/pdfinfo/pdfimages:
#   brew install poppler   |   apt-get install poppler-utils
# docling uses the parse-engine/ sidecar (layout, tables, formulas, OCR). A named
# reader that is unavailable fails the intake; auto prefers docling and records an
# extractor-fallback warning when it has to use poppler. DOCX/PPTX need `unzip`.
# HYPOTHESIS_PDF_EXTRACTOR=poppler     # poppler | docling | auto
# HYPOTHESIS_PDF_TEXT_MODE=reading     # reading | raw (poppler only; raw keeps content-stream order)
# HYPOTHESIS_SOURCE_ASSETS_DIR=.data/hypothesis-source-assets
#
# Docling sidecar one-time setup:
#   cd parse-engine && uv venv .venv --python 3.12 && uv pip install docling onnxruntime
# DOCLING_PYTHON=parse-engine/.venv/bin/python   # default location
# DOCLING_DEVICE=cpu          # cpu | mps (default mps only on Apple silicon; formulas force cpu)
# DOCLING_OCR=on              # on | off
# DOCLING_FORMULAS=on         # on | off (LaTeX equation enrichment)
# DOCLING_MAX_PAGES=0         # 0 = whole document
# DOCLING_TIMEOUT_MS=600000

# --- RAG-Anything multimodal index (rag-engine/) -------------------------------
# Inert unless RAG_ENGINE=on (or always) AND rag-engine/.venv exists. With `on` the
# paid index is skipped for one text-only source under 40,000 characters (recorded
# as skipReason); `always` indexes every source. One-time setup:
#   cd rag-engine && uv venv .venv --python 3.12 && uv pip install raganything
# RAG_ENGINE=on
# RAG_PYTHON=rag-engine/.venv/bin/python
# RAG_LLM_MODEL=               # else OPENROUTER_MODEL, else the sidecar's built-in default
# OPENROUTER_MODEL=
# RAG_VISION_MODEL=            # else OPENROUTER_VISION_MODEL, else the sidecar's built-in default
# EMBEDDINGS_API_KEY=          # OpenAI-compatible embeddings endpoint
# EMBEDDINGS_BASE_URL=https://openrouter.ai/api/v1   # base only; /embeddings is appended
# EMBEDDINGS_API_URL=          # full URL instead of a base
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_DIM=1536
# RAG_INDEX_ESTIMATE_USD=0.02  # estimated; the sidecar exposes no invoice usage
# RAG_INDEX_TIMEOUT_MS=600000
# RAG_QUERY_ESTIMATE_USD=0.005
# RAG_QUERY_TIMEOUT_MS=120000

# --- Speech: ElevenLabs with local fallback ------------------------------------
# TTS_PROVIDER=elevenlabs        # default is the local voice engine + forced alignment
# ELEVENLABS_API_KEY_1=          # _1.._9 all work; the pool spends the first key with credits left and retires spent/refused keys
# ELEVENLABS_API_KEY_2=
# ELEVENLABS_API_KEY_3=
# ELEVENLABS_CAPABILITIES_FILE=.data/elevenlabs-capabilities.json  # operator-captured (`pnpm run elevenlabs:capture`); required for synthesis
# TTS_FALLBACK_LOCAL=1           # when every key is spent/refused/unreachable, carry the scene with local synthesis (recorded as soft v2-tts-fallback-local); =0 keeps the failure hard

# --- Voice and forced alignment (voice-engine/, shared/alignment/) -------------
# Local and free: `pnpm run voice-engine:setup` once.
# VOICE_ENGINE_OUT=./voice-engine/out
# VOICE_ENGINE_WORKERS=1           # each worker holds a TTS model in memory
# HYPOTHESIS_ALIGNMENT_WORKERS=2   # persistent stable-ts workers

# --- Host-wide work limits (shared by local lesson processes) ------------------
# Positive integers. Defaults: provider/S6/TTS 2, S5 scene fan-out 4, raster 2.
# HYPOTHESIS_PROVIDER_CONCURRENCY=2
# HYPOTHESIS_SCENE_CONCURRENCY=4
# HYPOTHESIS_S6_CONCURRENCY=2
# HYPOTHESIS_TTS_ALIGNMENT_CONCURRENCY=2
# HYPOTHESIS_RASTER_CONCURRENCY=2
# HYPOTHESIS_RASTER_CACHE_MAX_BYTES=268435456   # 256 MiB
# HYPOTHESIS_RESOURCE_POOL_DIR=                 # shared lock root; defaults under the OS temp dir

# Icon libraries: `local-dev` also loads review-licence libraries (flaticon, bridge-streamline, bridge-sketchi). Unset = production (permissive licences only).
# Export it in the shell that runs lessons and `pnpm run icons:search`; runs that admit review assets can never pass the release rights gate.
# ASSET_USAGE_CONTEXT=local-dev
