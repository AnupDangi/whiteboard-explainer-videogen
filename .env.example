# The offline fixtures and core tests need no keys or npm dependencies.
PORT=3000
# OpenRouter planner — replaces legacy Anthropic direct integration.
OPENROUTER_API_KEY=
# Cheap structured JSON planner. Alternatives: z-ai/glm-5.3-flash, deepseek/deepseek-v4-flash, google/gemini-3-flash-preview
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Legacy Anthropic vars kept for backwards compat if ANTHROPIC_* present, but OPENROUTER_* is preferred.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# Optional, paid narration. Use a voice you have permission to use.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional, free local neural voice (Kokoro-82M via MLX on Apple Silicon).
# Point at a Python with kokoro-mlx + mlx + spacy en_core_web_sm installed,
# e.g. KOKORO_PYTHON=/tmp/kokoro-spike/bin/python (plus espeak-ng on PATH).
# KOKORO_PYTHON=
# Optional persistent server (model loads once; kills per-spawn warmup+flakes):
# run `KOKORO_PYTHON=... npm run kokoro-server`, then set:
# KOKORO_SERVER_URL=http://127.0.0.1:8765
# Optional caps
TTS_MAX_CHARACTERS_PER_JOB=40000
