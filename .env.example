# The offline fixtures and core tests need no keys or npm dependencies.
PORT=3000
# OpenRouter planner — replaces legacy Anthropic direct integration.
OPENROUTER_API_KEY=
# Default (code fallback if unset) is google/gemini-3.8-flash — confirmed current best
# fast/structured-JSON model in the OpenRouter catalog as of this check; no newer
# variant exists yet. Only set this to override, e.g. for an ablation run.
# OPENROUTER_MODEL=google/gemini-3.8-flash
# Legacy Anthropic vars kept for backwards compat if ANTHROPIC_* present, but OPENROUTER_* is preferred.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# Optional, paid narration (kokoro is the default free local voice; set --tts elevenlabs
# to use this instead). Use a voice you have permission to use.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Kokoro (default voice, free, local, no key): run `npm run kokoro:setup` once — creates
# a persistent venv at .kokoro-venv/ (not /tmp, so it survives reboots). The server then
# auto-starts itself on first use; you never need to run it manually. Only set these to
# override the defaults (persistent venv path / http://127.0.0.1:8765):
# KOKORO_PYTHON=
# KOKORO_SERVER_URL=
# Optional caps
TTS_MAX_CHARACTERS_PER_JOB=40000
# Optional LD4 hybrid retrieval: embeddings provider (OpenAI-compatible /embeddings
# endpoint). Without a key, retrieval stays BM25-only (deterministic, zero-dep) and
# the job ledger records retrievalMode bm25 — failures degrade visibly, never silently.
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_API_URL=https://api.openai.com/v1/embeddings
# EMBEDDINGS_MODEL=text-embedding-3-small

# Experimental manual scene lab; V1 remains default until V2 migration gates pass.
VISUAL_PIPELINE=v1
