# The offline fixtures and core tests need no keys or npm dependencies.
PORT=3000
# Optional production runtime. When set, the server runs the PostgreSQL-backed
# durable queue and applies migrations/001_durable_runtime.sql on startup.
# Requires the optional `pg` package in the deployment image.
# DATABASE_URL=postgres://user:password@localhost:5432/explain_canvas
# PG_POOL_MAX=10
# MIGRATIONS_DIR=/absolute/path/to/migrations
# OpenRouter planner — replaces legacy Anthropic direct integration.
OPENROUTER_API_KEY=
# Default text model is qwen/qwen3.8-flash. Text stages fall back to
# deepseek/deepseek-v4.1-flash; vision stages default to
# deepseek/deepseek-v4-flash-vision-exp. Set this to override the primary model.
# OPENROUTER_MODEL=qwen/qwen3.8-flash
# Optional per-stage overrides (the canonical TeachingBeat writer follows the content
# fallback chain when its primary model is unavailable).
# OPENROUTER_TEACHING_MODEL=qwen/qwen3.8-flash
# OPENROUTER_CONTENT_FALLBACKS=qwen/qwen3.8-flash,deepseek/deepseek-v4.1-flash
# OPENROUTER_DIRECTOR_FALLBACKS=qwen/qwen3.8-flash,deepseek/deepseek-v4.1-flash
# Legacy Anthropic vars kept for backwards compat if ANTHROPIC_* present, but OPENROUTER_* is preferred.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# Optional, paid narration (the free local voice-engine is the default; set --tts
# elevenlabs to use this instead). Use a voice you have permission to use.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Local voice-engine (default, free, no key): Supertonic by default with Piper fallback,
# all languages. One-time setup: `npm run voice-engine:setup` (or `cd voice-engine && npm run setup`).
# Overrides (all optional):
# VOICE_ENGINE_DIR=./voice-engine
# VOICE_ENGINE_PROVIDER=auto|supertonic|piper
# VOICE_ENGINE_LANGUAGE=en
# VOICE_ENGINE_OUT=./voice-engine/out
# Optional caps
TTS_MAX_CHARACTERS_PER_JOB=40000
# Optional LD4 hybrid retrieval: embeddings provider (OpenAI-compatible /embeddings
# endpoint). Without a key, retrieval stays BM25-only (deterministic, zero-dep) and
# the job ledger records retrievalMode bm25 — failures degrade visibly, never silently.
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_API_URL=https://api.openai.com/v1/embeddings
# EMBEDDINGS_MODEL=text-embedding-3-small
# Or reuse the OpenRouter key above for hybrid retrieval (BM25 + embeddings):
# RETRIEVAL_EMBEDDINGS=on

# --- Document intake (src/experimental/hypothesis/v1_claude/plan/intake/) ---
# PDF reader. poppler (default) needs pdftotext/pdfinfo/pdfimages:
#   brew install poppler   |   apt-get install poppler-utils
# docling uses the parse-engine/ sidecar (layout, tables, formulas, OCR). A named
# reader that is unavailable fails the intake; auto prefers docling and records an
# extractor-fallback warning when it has to use poppler.
# HYPOTHESIS_PDF_EXTRACTOR=poppler     # poppler | docling | auto
# HYPOTHESIS_PDF_TEXT_MODE=reading     # reading | raw  (poppler only; raw keeps content-stream order)
# HYPOTHESIS_SOURCE_ASSETS_DIR=.data/hypothesis-source-assets
# DOCX/PPTX reading needs `unzip`.
#
# Docling sidecar one-time setup:
#   cd parse-engine && uv venv .venv --python 3.12 && uv pip install docling onnxruntime
# DOCLING_PYTHON=parse-engine/.venv/bin/python   # default location
# DOCLING_DEVICE=cpu          # cpu | mps (default mps only on Apple silicon; formula enrichment forces cpu)
# DOCLING_OCR=on              # on | off (RapidOCR / PP-OCR when installed)
# DOCLING_FORMULAS=on         # on | off (LaTeX equation enrichment; runs on cpu)
# DOCLING_MAX_PAGES=0         # 0 = whole document
# DOCLING_TIMEOUT_MS=600000

# --- RAG-Anything deep multimodal index (rag-engine/) ---
# Inert unless RAG_ENGINE=on AND rag-engine/.venv exists. One-time setup:
#   cd rag-engine && uv venv .venv --python 3.12 && uv pip install raganything
# Uses OpenRouter for LLM/VLM and an OpenAI-compatible embeddings endpoint.
# RAG_ENGINE=on
# RAG_PYTHON=rag-engine/.venv/bin/python
# RAG_LLM_MODEL=qwen/qwen3.8-flash
# RAG_VISION_MODEL=deepseek/deepseek-v4-flash-vision-exp
# EMBEDDINGS_BASE_URL=https://openrouter.ai/api/v1   # base only; /embeddings is appended
# EMBEDDINGS_DIM=1536
# RAG_INDEX_ESTIMATE_USD=0.02                    # explicitly estimated; sidecar exposes no invoice usage
# RAG_INDEX_TIMEOUT_MS=600000
# RAG_QUERY_ESTIMATE_USD=0.005                    # retrieval embeddings are also estimated
# RAG_QUERY_TIMEOUT_MS=120000

# --- Local forced alignment worker pool ---
# Persistent stable-ts/faster-whisper workers retain one model per worker.
# HYPOTHESIS_ALIGNMENT_WORKERS=2
# Voice workers also retain provider models; default 1 avoids multiplying the
# Supertonic model's memory footprint. Increase only after measuring CPU/RAM.
# VOICE_ENGINE_WORKERS=1

# Optional HTTP forced-aligner for word-level TTS timing. When unset, local TTS
# uses deterministic duration estimation; when configured, returned anchors drive
# the visual timing cascade.
# FORCED_ALIGNER_URL=http://127.0.0.1:8765/align
# FORCED_ALIGNER_LANGUAGE=en

# Hypothesis track: every stage model is configuration; there are no code defaults.
# OPENROUTER_CONTENT_MODEL=   # S2-S4 (falls back to OPENROUTER_DIRECTOR_MODEL)
# OPENROUTER_SCENE_MODEL=     # S6 board planner (required)
# OPENROUTER_VISION_MODEL=    # vision judge (required for judge:hypothesis)
# HYPOTHESIS_ENV_FILE=        # optional path to a different env file

# Host-wide Hypothesis work limits (shared by local lesson processes).
# Values are positive integers; provider/S6/TTS defaults are 2, S5 scene fanout 4, raster 2.
# HYPOTHESIS_PROVIDER_CONCURRENCY=2
# HYPOTHESIS_SCENE_CONCURRENCY=4
# HYPOTHESIS_S6_CONCURRENCY=2
# HYPOTHESIS_TTS_ALIGNMENT_CONCURRENCY=2
# HYPOTHESIS_RASTER_CONCURRENCY=2
# HYPOTHESIS_RASTER_CACHE_MAX_BYTES=268435456   # defaults to 256 MiB
# HYPOTHESIS_RESOURCE_POOL_DIR=                 # optional shared lock root; defaults under OS temp
