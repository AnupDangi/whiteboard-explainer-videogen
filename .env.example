# The offline fixtures and core tests need no keys or npm dependencies.
PORT=3000
# OpenRouter planner — replaces legacy Anthropic direct integration.
OPENROUTER_API_KEY=
# Three-model shortlist (all support structured JSON output):
# 1) google/gemini-3-flash-preview — outline/content/direction/vision; cache parts disabled
# 2) qwen/qwen3.5-27b — alternate content route, economical
# 3) deepseek/deepseek-v3.2 — economical long-document alternative
# OPENROUTER_MODEL=google/gemini-3-flash-preview
OPENROUTER_MODEL_FALLBACKS=google/gemini-3-flash-preview,qwen/qwen3.5-27b,deepseek/deepseek-v3.2
# semantic-v3 front end (Architecture_plan.md §54). Defaults are the architecture
# document's model routing; override here or via MODEL_ROUTER JSON. A route that
# does not resolve fails visibly — it never becomes a fixture or a silent success.
# OPENROUTER_GRAPH_MAP_MODEL=openai/gpt-5.6-luna
# OPENROUTER_GRAPH_REDUCE_MODEL=openai/gpt-5.6-luna
# OPENROUTER_TEACHER_PLANNER_MODEL=openai/gpt-5.6-luna
# OPENROUTER_SCENE_WORKER_MODEL=openai/gpt-5.6-luna
# OPENROUTER_RESCUE_MODEL=anthropic/claude-sonnet-5
# OPENROUTER_V3_FALLBACKS=google/gemini-3.8-flash,anthropic/claude-haiku-4.5,qwen/qwen3.5-27b
# Legacy Anthropic vars kept for backwards compat if ANTHROPIC_* present, but OPENROUTER_* is preferred.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# Narration is local-only: the free CPU voice-engine (Supertonic 3 / Piper), no key.
# Local voice-engine (default narration, free, CPU, no key): Supertonic 3 default with
# Piper fallback; Nepali is always Piper. Lives at voice-engine.
# VOICE_ENGINE_DIR=/absolute/path/to/voice-engine
# VOICE_ENGINE_LANGUAGE=en
# VOICE_ENGINE_PROVIDER=auto
# Optional caps
TTS_MAX_CHARACTERS_PER_JOB=40000
# Optional LD4 hybrid retrieval: embeddings provider (OpenAI-compatible /embeddings
# endpoint). Without a key, retrieval stays BM25-only (deterministic, zero-dep) and
# the job ledger records retrievalMode bm25 — failures degrade visibly, never silently.
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_API_URL=https://api.openai.com/v1/embeddings
# EMBEDDINGS_MODEL=text-embedding-3-small

# Pipelines: semantic (V2, default) | semantic-v3 (target front end, opt-in) | explainer (V1, frozen legacy).
# Code default is semantic (src/semantic/pipeline.ts:8).
VISUAL_PIPELINE=semantic
